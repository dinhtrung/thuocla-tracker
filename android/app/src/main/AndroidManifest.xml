<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Offline by construction: no android.permission.INTERNET is declared, and the
        app must never add it. Everything lives in the app's own Room database.
    -->
    <application
        android:name=".ThuoclaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Thuốc lá"
        android:supportsRtl="false"
        android:theme="@style/Theme.Thuocla">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Thuocla">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
