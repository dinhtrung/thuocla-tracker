<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Offline by construction: no android.permission.INTERNET is declared, and the
        app must never add it. Everything lives in the app's own Room database.
    -->
    <application
        android:name=".ThuoclaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Thuốc lá"
        android:supportsRtl="false"
        android:theme="@style/Theme.Thuocla">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Thuocla">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Share-out path (issue #34): the JSON backup copy lives in cacheDir/backups/ and leaves the
            app only through this provider — content:// + a temporary read grant. Not exported, so no
            other app can open it without the grant the chooser hands out. See res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
