<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Offline by construction: no android.permission.INTERNET is declared, and the
        app must never add it. Everything lives in the app's own Room database.
    -->
    <application
        android:name=".ThuoclaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Thuốc lá"
        android:supportsRtl="false"
        android:theme="@style/Theme.Thuocla">
        <!--
            The single entry point: the web UI served from assets/web/ (issue #37). The Compose
            activity that used to sit beside it was deleted in task 5.4 (#55), so there is exactly
            one activity in the app.
        -->
        <activity
            android:name=".web.WebShellActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Thuocla">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
